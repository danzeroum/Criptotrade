# Application
APP_ENV=development
LOG_LEVEL=INFO

# Authentication (P0-1)
# Comma-separated keys, e.g. "key1,key2". Leave UNSET in local dev (fail-open).
# MANDATORY in production — without this the API is public.
# API_KEYS=change-me-in-prod

# CORS (P0-2)
# Comma-separated origins. Default "*" (open). Restrict in production:
# CORS_ORIGINS=https://criptotrade.buildtovalue.cloud

# Market pair allowlist (P2-2)
# Comma-separated pairs accepted by /v1/market/{pair}/* (and the dashboards).
# Default: BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
# MARKET_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# Symbols the autonomous loop trades each cycle (opt-in multi-symbol).
# Comma-separated; each must be in MARKET_PAIRS. Unset => BTC/USDT only.
# SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT

# AI Models
GOOGLE_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_backup_key_here
# ANTHROPIC_API_KEY=your_claude_key_here

# LLM reasoning layer (Chain-of-Thought for StrategyAgent, Reflection for
# RiskAgent). DISABLED by default — the pipeline runs fully deterministic and
# offline unless LLM_ENABLED=true AND a provider key above is set. Advisory only
# (guardrails + HITL remain the safety net).
LLM_ENABLED=false
LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-flash

# Exchange (Paper Trading)
EXCHANGE=binance
EXCHANGE_API_KEY=paper_trading_key
EXCHANGE_API_SECRET=paper_trading_secret
EXCHANGE_TESTNET=true
# MANDATORY (no default). true = synthetic data, zero network. false = real
# exchange (production only). Unset => the client refuses to start.
EXCHANGE_DRY_RUN=true
# Order routing — INDEPENDENT of EXCHANGE_DRY_RUN (the market-data source):
#   paper (default) = simulated fills · live = real orders (requires
#   EXCHANGE_DRY_RUN=false + exchange credentials).
#   "real price + paper execution" = EXCHANGE_DRY_RUN=false + ORDER_ROUTING=paper.
ORDER_ROUTING=paper
# Base price for BTC/USDT (and the dry-run anchor). Other majors get sensible
# built-in defaults (ETH~3000, SOL~150, BNB~600, XRP~0.5); unmapped pairs get a
# deterministic per-symbol price so every coin no longer renders identically.
DRY_RUN_BASE_PRICE=50000
# Optional per-symbol overrides: comma-separated PAIR=PRICE (e.g.
# BTC/USDT=50000,ETH/USDT=3000,SOL/USDT=150). Overrides the built-in defaults.
DRY_RUN_BASE_PRICES=

# Trading Parameters
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE_PCT=5
STOP_LOSS_PCT=3
MAX_DAILY_LOSS_PCT=5
MAX_CONCURRENT_POSITIONS=3

# Autonomy
AUTONOMY_LEVEL=1
HITL_APPROVAL_REQUIRED=true

# Orchestrator loop (Phase 4b-iii) — validated range [10, 3600] seconds
ORCHESTRATOR_INTERVAL_SECONDS=60

# Database
DATABASE_URL=sqlite:///./data/trading.db

# Docker Compose infra credentials (no defaults in compose — set real values;
# never commit your .env). Left commented on purpose so a hasty `cp .env.example
# .env` can't ship predictable passwords (e.g. openssl rand -hex 16).
POSTGRES_DB=buildtoflip_dev
# POSTGRES_USER=set-a-real-user
# POSTGRES_PASSWORD=set-a-strong-password
GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=set-a-strong-password

# Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# Monitoring
PROMETHEUS_PORT=9090
