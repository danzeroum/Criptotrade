# Production environment template for Criptotrade (P3-2 deploy hardening).
# Copy to `.env`, set a strong API_KEYS secret, then deploy with:
#   docker compose -f docker-compose.prod.yml up -d
#
# The API runs a FAIL-CLOSED guard (see src/api/main.py:_enforce_prod_security):
# with APP_ENV=production it REFUSES to start unless API_KEYS is set and
# CORS_ORIGINS is an explicit allowlist (not '*').

# Marks the deploy as production → enables the fail-closed security guard.
APP_ENV=production

# REQUIRED. Comma-separated API keys; clients send one as the `X-API-Key`
# header. Generate strong values, e.g.:  openssl rand -hex 32
# This file is a committed TEMPLATE — never put real keys here; they live in .env.
API_KEYS=replace-with-a-strong-random-key

# REQUIRED in prod — explicit CORS allowlist, never '*'. The prod compose also
# sets this; keep them consistent if you override here.
CORS_ORIGINS=https://criptotrade.buildtovalue.cloud

# Keep synthetic/offline trading. P3-2 hardens the deploy; going live is a
# separate, deliberate decision (do not flip to false here).
EXCHANGE_DRY_RUN=true

# Symbols the autonomous loop trades each cycle (opt-in multi-symbol; each must
# be in MARKET_PAIRS). Unset => BTC/USDT only. More symbols => more exposure.
# SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
