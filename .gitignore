# Environment and secrets
.env
.env.*
# Keep versioned templates (no real secrets) tracked
!.env.example
!.env.template
!.env.prod.example

# Python artifacts
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
.Python
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
.envrc

# Project data and logs
data/
logs/

# Runtime ledger & logs (append-only artifacts mutated by agents/tests)
*.jsonl
.buildtovalue/ledger/
.buildtovalue/logs/

# Tooling
.coverage
htmlcov/

# Node/Streamlit caches
.streamlit/

# Node deps & Console build output (docs/design/pages — built in CI/deploy)
node_modules/
docs/design/pages/dist/

# Playwright E2E artifacts (console)
docs/design/pages/test-results/
docs/design/pages/playwright-report/
docs/design/pages/blob-report/

# BuildToValue assets
docs/UX/mockups.zip

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/

# Keys, certs and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json

# Local databases / dumps
*.sqlite
*.db
*.db-wal
*.db-shm
*.sql
# ...but versioned schema migrations must be tracked
!migrations/*.sql
